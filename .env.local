# If these are left blank or unset, the app automatically falls back to a
# local, in-browser mock data store (via localStorage) so you can run and
# demo the app without a Supabase project configured yet.

# Optional: the deployed URL of the mysql-proxy service (see
# mysql-proxy/README.md), needed only if you want the "Live Server
# (MySQL)" sandbox mode. Leave unset to use only the bundled, zero-setup
# SQLite sandbox.
VITE_MYSQL_PROXY_URL=
