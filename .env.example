# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# If these are left blank or unset, the app automatically falls back to a
# local, in-browser mock data store (via localStorage) so you can run and
# demo the app without a Supabase project configured yet.
