# Copy to .env (local dev) or set these as environment variables in your
# hosting platform (e.g. Render service -> Environment tab).

PORT=4000

# The deployed frontend's origin, e.g. https://skillbuilderapp.onrender.com
# Restricts which site is allowed to call this proxy. Use the frontend's
# real deployed URL, not "*", once you're past local testing.
ALLOWED_ORIGIN=http://localhost:5173
